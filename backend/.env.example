# ── App ──────────────────────────────────────────
APP_NAME="AI Turniket System"
DEBUG=true

# ── Database ──────────────────────────────────────
# SQLite (dev)
DATABASE_URL=sqlite:///./turniket.db

# PostgreSQL (production) – uncomment and fill in:
# DATABASE_URL=postgresql://turniket_user:strongpassword@localhost:5432/turniket_db

# ── Security ──────────────────────────────────────
SECRET_KEY=change-me-to-a-random-64-char-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Default admin ─────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ── Face recognition ──────────────────────────────
FACE_DISTANCE_THRESHOLD=0.55
MAX_IMAGE_SIZE_MB=5

# ── CORS ──────────────────────────────────────────
# Comma-separated list handled in config.py
